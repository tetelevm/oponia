# Local development settings. Copy this file to .env.
WEB_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

POSTGRES_DB=oponia
POSTGRES_USER=oponia
POSTGRES_PASSWORD=oponia_local

# SQLAdmin login. Empty ADMIN_PASSWORD disables the admin interface.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=oponia_admin_local
ADMIN_SECRET_KEY=oponia_admin_session_key_local_change_before_deployment

RABBITMQ_DEFAULT_USER=oponia
RABBITMQ_DEFAULT_PASS=oponia_local
